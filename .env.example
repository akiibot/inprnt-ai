# Imprnt AI — Environment Variables Example
# Copy this file to .env and fill in your values.
APP_ENV=development
DEMO_FALLBACK_MODE=False

# ── Google Gemini (use ONE of the two options below) ──────────────────────────
#
# Option A — AI Studio API key (simpler, good for dev)
#   Get one at: https://aistudio.google.com/app/apikey
#   Key starts with "AIza..."
GOOGLE_AI_API_KEY=

# Option B — Google Cloud Service Account JSON key (Vertex AI, recommended for prod)
#   1. Create a service account in Google Cloud Console
#   2. Enable the "Vertex AI API" on your project
#   3. Download the JSON key and set the path below
GOOGLE_SERVICE_ACCOUNT_PATH=

# ── Cloudflare Workers AI (Flux background generation) ───────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Remove.bg (product image background removal) ─────────────────────────────
# 50 free calls. If credits run out, images are uploaded without bg removal.
REMOVEBG_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
