# =============================================================
# Imprnt AI — Environment Variables
# Copy this file to .env and fill in your real keys.
# NEVER commit .env to version control.
# =============================================================

# ── AI "A" — Google AI Studio (Gemini) ──────────────────────
GOOGLE_AI_API_KEY=your_google_ai_studio_api_key_here

# ── AI "B" — Cloudflare Workers AI (Flux image generation) ──
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# ── Background Removal ───────────────────────────────────────
REMOVEBG_API_KEY=your_removebg_api_key_here

# ── Database & Storage — Supabase ────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── App Config ───────────────────────────────────────────────
# Backend URL (as seen by the frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo fallback: set to "true" to serve pre-generated cached PNGs
DEMO_FALLBACK_MODE=false

# Environment: "development" | "production"
APP_ENV=development

# ── CORS (backend) ───────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development default is set automatically; only set this in production.
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
